# URL of the deployed (or local) backend API — include the /api suffix.
# Local dev: http://localhost:5000/api
# Production: https://your-server-project.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Pusher (Channels) app credentials — public "key" and "cluster" only.
# Get these from https://dashboard.pusher.com after creating an app.
# Must match the same app used by the server's PUSHER_APP_ID/SECRET.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap2
