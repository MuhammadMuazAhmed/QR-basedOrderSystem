# --- Database (MongoDB Atlas recommended — required for Vercel deployment) ---
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/qr_cafeteria

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# One-time secret used to create your FIRST admin account via
# POST /api/auth/setup. Set it to something long and random, use it once,
# then you may rotate/remove it (it only matters until the first admin
# exists — after that, /api/auth/setup always returns 409).
SETUP_SECRET=change_this_to_a_long_random_string_too

# --- CORS ---
# Exact origin(s) of your deployed client app. Comma-separate multiple
# origins (e.g. local dev + production) — no trailing slashes.
CLIENT_URL=http://localhost:5173,https://your-client.vercel.app

# --- Real-time (Pusher) ---
# Create a free app at https://dashboard.pusher.com (Channels product).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# --- QR / Table config (used by local scripts only) ---
TABLE_COUNT=10
# The URL customers' phones should open after scanning — your deployed
# CLIENT app's URL in production, or http://localhost:5173 for local testing.
PUBLIC_CLIENT_URL=http://localhost:5173

# --- Blink API (Jazeera Foods menu source) — see src/scraper/README.md ---
BLINK_BASE_URL=https://api.blinkco.io
BLINK_USERNAME=
BLINK_PASSWORD=
