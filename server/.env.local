TABLE_COUNT=10
# Base URL the customer's phone will actually open after scanning.
# For local testing on the SAME machine use http://localhost:5173
# For testing on a REAL PHONE, use your computer's LAN IP, e.g. http://192.168.1.10:5173
PUBLIC_CLIENT_URL=https://qr-based-order-system.vercel.app

# --- Cafeteria info (used on receipts) ---
CAFETERIA_NAME=Cafeteria

# --- Blink API (Jazeera Foods menu source) ---
# These are ONLY needed if you run `npm run import:menu` to pull the live
# Jazeera Foods menu from their Blink ordering backend. Blink requires
# merchant-issued credentials (see server/src/scraper/README.md) — the
# public jazeerafoods.com website cannot be scraped directly because it's
# a client-side rendered app that calls this authenticated API.
BLINK_BASE_URL=https://api.blinkco.io
BLINK_USERNAME=
BLINK_PASSWORD=
